<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deljeni ugovor sa D2D Backend-om — jedan fizički fajl na koren repoa,
         v. proto/notification.proto. "Both", ne samo "Server": D2D Backend
         generiše svoj klijent nezavisno, ali integracioni testovi za OVAJ
         servis referenciraju direktno ovaj projekat, pa im treba i klijent
         stub generisan ovde — tako ga ne generišu ponovo sami, što bi
         pravilo duple, sudarajuće tipove poruka. -->
    <Protobuf Include="..\..\..\proto\notification.proto" GrpcServices="Both" Link="Protos\notification.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" Version="2.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotificationService.Infrastructure\NotificationService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
