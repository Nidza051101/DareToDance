{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "",
    "ExpiryMinutes": 15,
    "Issuer": "DareToDance.Api",
    "Audience": "DareToDance.Client"
  },
  "OtpSettings": {
    "CodeLength": 6,
    "ExpirySeconds": 600,
    "MaxFailedAttempts": 3,
    "ResendCooldownSeconds": 60,
    "MaxCodesPerDay": 10,
    "Pepper": ""
  },
  "RateLimitSettings": {
    "OtpRequestPermitLimit": 5,
    "OtpRequestWindowMinutes": 15,
    "OtpVerifyPermitLimit": 10,
    "OtpVerifyWindowMinutes": 15
  }
}
