{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "",
    "ExpiryMinutes": 15,
    "Issuer": "DareToDance.Api",
    "Audience": "DareToDance.Client"
  },
  "OtpSettings": {
    "CodeLength": 6,
    "ExpirySeconds": 60,
    "MaxFailedAttempts": 3,
    "ResendCooldownSeconds": 60
  }
}
