<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>2b5f147a-c002-4778-aea9-aa806c8c1f93</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
      <!-- MediatR 12.5.0 = poslednja Apache-2.0 verzija; od v13 traži license key -->
      <PackageReference Include="MediatR" Version="14.2.0" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
      <!-- Design je potreban za dotnet ef komande; ne curi u runtime -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
      <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DareToDance.Infrastructure\DareToDance.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Features\Users\Queries\" />
    </ItemGroup>

</Project>
